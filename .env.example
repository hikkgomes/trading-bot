# Copy to .env and fill in. .env is gitignored. NEVER commit real keys.
# Consumed by src/execution (spot/futures broker adapters). Live trading is opt-in:
# adapters default to paper/testnet unless TRADING_LIVE=1 is explicitly set.

# --- Exchange selection (ccxt venue ids) ---
# Active-income live futures are intentionally restricted to Binance USDT-M.
# BTC accumulation spot uses SPOT_EXCHANGE.
FUTURES_EXCHANGE=binanceusdm
SPOT_EXCHANGE=binance
EXCHANGE_MARKET_TYPE=futures  # default when constructing a broker outside autopilot
EXCHANGE_TESTNET=1            # 1 = use the exchange sandbox/testnet

# --- API credentials ---
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Some venues (okx, etc.) also need a passphrase:
EXCHANGE_API_PASSWORD=

# --- Safety switches ---
TRADING_LIVE=0               # 0 = paper/simulated fills; 1 = send real orders
MAX_NOTIONAL_USD=100         # hard cap per order, enforced client-side
MAX_FILL_SLIPPAGE_BPS=100    # max fill-vs-reference deviation accepted into local state
QUOTE_ASSET=USDT             # required by both configured products
FUTURES_MARGIN_MODE=isolated # futures only; required for live entries
MAX_FUTURES_LEVERAGE=1       # futures only; live/preflight accept 1-3, broker sets before entries

# --- Autopilot ---
# Live execution also requires a matching strategy fingerprint in
# runtime/approvals.json. Environment switches alone are not sufficient.
AUTOPILOT_CONFIG=config/autopilot.json
AUTOPILOT_WEBHOOK_URL=
