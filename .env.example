# Copy to .env and fill in. .env is gitignored. NEVER commit real keys.
# Consumed by src/execution (spot/futures broker adapters). Live trading is opt-in:
# adapters default to paper/testnet unless TRADING_LIVE=1 is explicitly set.

# --- Exchange selection (ccxt venue ids) ---
# Active-income live futures are intentionally restricted to Binance USDT-M.
# BTC accumulation spot uses SPOT_EXCHANGE.
FUTURES_EXCHANGE=binanceusdm
SPOT_EXCHANGE=binance
# Default when constructing a broker outside autopilot.
EXCHANGE_MARKET_TYPE=futures
# 1 = use the exchange sandbox/testnet.
EXCHANGE_TESTNET=1

# --- API credentials ---
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Some venues (okx, etc.) also need a passphrase:
EXCHANGE_API_PASSWORD=

# --- Safety switches ---
# 0 = paper/simulated fills; 1 = send real orders.
TRADING_LIVE=0
# Hard cap per order, enforced client-side. Keep it above Binance's current
# amount/notional minimum after precision rounding or rehearsal will fail closed.
MAX_NOTIONAL_USD=250
# Maximum fill-vs-reference deviation accepted into local state.
MAX_FILL_SLIPPAGE_BPS=100
# Required by both configured products.
QUOTE_ASSET=USDT
# Futures only; required for live entries.
FUTURES_MARGIN_MODE=isolated
# Futures only; active-income live execution requires 1x and sets it before entries.
MAX_FUTURES_LEVERAGE=1

# --- Autopilot ---
# Live execution also requires a matching strategy fingerprint in
# runtime/approvals.json. Environment switches alone are not sufficient.
AUTOPILOT_CONFIG=config/autopilot.json
# Webhook and Telegram routing live in the separate owner-private
# runtime/alerts.env file so the watchdog never needs exchange credentials.
# See config/alerts.env.example and docs/COMMUNICATIONS.md.
