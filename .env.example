# Copy to .env and fill in. .env is gitignored. NEVER commit real keys.
# Consumed by src/execution (futures broker adapters). Live trading is opt-in:
# adapters default to paper/testnet unless TRADING_LIVE=1 is explicitly set.

# --- Exchange selection (any ccxt-supported futures venue) ---
EXCHANGE=binanceusdm          # e.g. binanceusdm, bybit, okx, ...
EXCHANGE_TESTNET=1            # 1 = use the exchange sandbox/testnet

# --- API credentials ---
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Some venues (okx, etc.) also need a passphrase:
EXCHANGE_API_PASSWORD=

# --- Safety switches ---
TRADING_LIVE=0               # 0 = paper/simulated fills; 1 = send real orders
MAX_NOTIONAL_USD=100         # hard cap per order, enforced client-side
