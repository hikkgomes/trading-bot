<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.trading-platform.__SERVICE__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPOSITORY__/scripts/run_platform_service.sh</string>
    <string>/Library/Application Support/TradingPlatform/platform.env</string>
    <string>__REPOSITORY__</string>
    <string>macbook-research</string>
    <string>__SERVICE__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPOSITORY__</string>
  <key>UserName</key>
  <string>trading-research</string>
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__REPOSITORY__/runtime/__SERVICE__.log</string>
  <key>StandardErrorPath</key>
  <string>__REPOSITORY__/runtime/__SERVICE__.error.log</string>
</dict>
</plist>
