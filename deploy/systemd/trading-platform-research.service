[Unit]
RequiresMountsFor=/opt/trading-bot/data /opt/trading-bot/runtime/backups
Description=Trading platform research process
After=network-online.target postgresql.service trading-platform-migration.service
Wants=network-online.target
Requires=postgresql.service trading-platform-migration.service

[Service]
Type=simple
User=trading-research
Group=trading-research
WorkingDirectory=/opt/trading-bot
EnvironmentFile=/etc/trading-platform/research.env
Environment=PYTHONUNBUFFERED=1
Environment=TRADING_PLATFORM_AGENT_WORKTREE_ROOT=/opt/trading-bot/runtime/research/agent-worktrees
Environment=GIT_CONFIG_COUNT=1
Environment=GIT_CONFIG_KEY_0=safe.directory
Environment=GIT_CONFIG_VALUE_0=/opt/trading-bot
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
Environment=NUMBA_CACHE_DIR=/opt/trading-bot/runtime/research/numba-cache
ExecStartPre=/opt/trading-bot/.venv-research/bin/python -m src.services.process --config /opt/trading-bot/config/platform.json --node linux-optiplex --process research-runtime --validate
ExecStart=/opt/trading-bot/.venv-research/bin/python -m src.services.process --config /opt/trading-bot/config/platform.json --node linux-optiplex --process research-runtime
TimeoutStartSec=300
Restart=always
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trading-bot/data/research /opt/trading-bot/runtime/research
ReadOnlyPaths=/opt/trading-bot/data/raw /opt/trading-bot/data/bars /opt/trading-bot/data/features
Slice=trading-platform-background.slice

[Install]
WantedBy=multi-user.target
