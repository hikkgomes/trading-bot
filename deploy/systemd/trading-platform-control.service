[Unit]
Description=Trading platform control and metrics API
After=network-online.target postgresql.service trading-platform-migration.service
Wants=network-online.target
Requires=postgresql.service trading-platform-migration.service

[Service]
Type=simple
User=trading-runtime
Group=trading-runtime
WorkingDirectory=/opt/trading-bot
EnvironmentFile=/etc/trading-platform/runtime.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/opt/trading-bot/.venv-runtime/bin/python -m src.services.supervisor --config /opt/trading-bot/config/platform.json --node linux-optiplex --service control-api --validate
ExecStart=/opt/trading-bot/.venv-runtime/bin/python -m src.services.supervisor --config /opt/trading-bot/config/platform.json --node linux-optiplex --service control-api
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/opt/trading-bot/runtime
Slice=trading-platform-critical.slice

[Install]
WantedBy=multi-user.target
