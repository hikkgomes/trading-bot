[Unit]
Description=Trading platform %i backup
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=trading-runtime
Group=trading-runtime
WorkingDirectory=/opt/trading-bot
EnvironmentFile=/etc/trading-platform/backup.env
ExecStart=/opt/trading-bot/.venv-runtime/bin/python -m src.services.backup_service --config /opt/trading-bot/config/platform.json --mode %i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trading-bot/runtime/backups
