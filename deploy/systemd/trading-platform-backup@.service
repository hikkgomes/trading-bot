[Unit]
RequiresMountsFor=/opt/trading-bot/data /opt/trading-bot/runtime/backups
Description=Trading platform %i backup
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=trading-runtime
Group=trading-runtime
Environment=NUMBA_CACHE_DIR=/opt/trading-bot/runtime/numba-cache
WorkingDirectory=/opt/trading-bot
EnvironmentFile=/etc/trading-platform/backup.env
ExecStart=/opt/trading-bot/.venv-runtime/bin/python -m src.services.backup_service --config /opt/trading-bot/config/platform.json --mode %i
TimeoutStartSec=8h
MemoryMax=768M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trading-bot/runtime/backups /opt/trading-bot/runtime/numba-cache
Slice=trading-platform-background.slice
Nice=10
IOSchedulingClass=idle
