[Unit]
RequiresMountsFor=/opt/trading-bot/data /opt/trading-bot/runtime/backups
Description=Trading platform frozen evaluation and dataset sealing
After=network-online.target postgresql.service trading-platform-migration.service
Wants=network-online.target
Requires=postgresql.service trading-platform-migration.service

[Service]
Type=simple
User=trading-evaluator
Group=trading-evaluator
WorkingDirectory=/opt/trading-bot
EnvironmentFile=/etc/trading-platform/evaluator.env
Environment=PYTHONUNBUFFERED=1
Environment=GIT_CONFIG_COUNT=1
Environment=GIT_CONFIG_KEY_0=safe.directory
Environment=GIT_CONFIG_VALUE_0=/opt/trading-bot
Environment=NUMBA_CACHE_DIR=/opt/trading-bot/runtime/evaluation/numba-cache
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
ExecStartPre=/opt/trading-bot/.venv-runtime/bin/python -m src.services.process --config /opt/trading-bot/config/platform.json --node linux-optiplex --process evaluation-runtime --validate
ExecStart=/opt/trading-bot/.venv-runtime/bin/python -m src.services.process --config /opt/trading-bot/config/platform.json --node linux-optiplex --process evaluation-runtime
Restart=always
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trading-bot/data/artefacts /opt/trading-bot/runtime/evaluation
MemoryMax=2048M
CPUQuota=200%
Slice=trading-platform-background.slice

[Install]
WantedBy=multi-user.target
