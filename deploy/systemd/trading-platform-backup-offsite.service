[Unit]
Description=Encrypted trading platform offsite backup
RequiresMountsFor=/opt/trading-bot/data /opt/trading-bot/runtime/backups
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=trading-runtime
Group=trading-runtime
WorkingDirectory=/opt/trading-bot
EnvironmentFile=/etc/trading-platform/backup.env
EnvironmentFile=/etc/trading-platform/offsite.env
Environment=PYTHONUNBUFFERED=1
Environment=NUMBA_CACHE_DIR=/opt/trading-bot/runtime/numba-cache
Environment=GOMAXPROCS=2
Environment=GOMEMLIMIT=512MiB
UMask=0077
ExecStart=/opt/trading-bot/.venv-runtime/bin/python -m src.services.offsite_backup --config /opt/trading-bot/config/platform.json
TimeoutStartSec=16h
MemoryMax=768M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trading-bot/runtime/backups /opt/trading-bot/runtime/numba-cache /etc/trading-platform/offsite
Slice=trading-platform-background.slice
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
IOWeight=10

