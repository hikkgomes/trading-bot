[Unit]
Description=Trading platform isolated agent process
After=network-online.target postgresql.service trading-platform-migration.service
Wants=network-online.target
Requires=postgresql.service trading-platform-migration.service

[Service]
Type=simple
User=trading-agent
Group=trading-agent
WorkingDirectory=/opt/trading-bot
EnvironmentFile=/etc/trading-platform/agent.env
Environment=PYTHONUNBUFFERED=1
Environment=TRADING_PLATFORM_AGENT_WORKTREE_ROOT=/opt/trading-bot/runtime/agent-worktrees
Environment=NUMBA_CACHE_DIR=/opt/trading-bot/runtime/agent-worktrees/numba-cache
Environment=GIT_CONFIG_COUNT=1
Environment=GIT_CONFIG_KEY_0=safe.directory
Environment=GIT_CONFIG_VALUE_0=/opt/trading-bot
ExecStartPre=/opt/trading-bot/.venv-agent/bin/python -m src.services.process --config /opt/trading-bot/config/platform.json --node linux-optiplex --process agent-runtime --validate
ExecStart=/opt/trading-bot/.venv-agent/bin/python -m src.services.process --config /opt/trading-bot/config/platform.json --node linux-optiplex --process agent-runtime
Restart=always
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trading-bot/runtime/agent-worktrees
Slice=trading-platform-agent.slice

[Install]
WantedBy=multi-user.target
