[Unit]
RequiresMountsFor=/opt/trading-bot/data /opt/trading-bot/runtime/backups
Description=Trading platform isolated agent process
After=network-online.target trading-platform-control.service
Wants=network-online.target
Requires=trading-platform-control.service

[Service]
Type=simple
User=trading-agent
Group=trading-agent
Environment=NUMBA_CACHE_DIR=/opt/trading-bot/runtime/agent-worktrees/numba-cache
WorkingDirectory=/opt/trading-bot
EnvironmentFile=/etc/trading-platform/agent.env
Environment=PYTHONUNBUFFERED=1
Environment=TRADING_PLATFORM_AGENT_API_URL=http://127.0.0.1:8088
Environment=TRADING_PLATFORM_MODEL_BROKER_SOCKET=/run/trading-platform-model-broker/model.sock
SupplementaryGroups=trading-model-broker
ExecStartPre=/opt/trading-bot/.venv-agent/bin/python -m src.services.process --config /opt/trading-bot/config/platform.json --node linux-optiplex --process agent-runtime --validate
ExecStart=/opt/trading-bot/.venv-agent/bin/python -m src.services.process --config /opt/trading-bot/config/platform.json --node linux-optiplex --process agent-runtime
Restart=always
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trading-bot/runtime/agent-worktrees
Slice=trading-platform-agent.slice

[Install]
WantedBy=multi-user.target
