[Unit]
RequiresMountsFor=/opt/trading-bot/data /opt/trading-bot/runtime/backups
Description=Trading platform market gateway
After=network-online.target postgresql.service trading-platform-migration.service
Wants=network-online.target
Requires=postgresql.service trading-platform-migration.service

[Service]
Type=simple
User=trading-runtime
Group=trading-runtime
Environment=NUMBA_CACHE_DIR=/opt/trading-bot/runtime/numba-cache
WorkingDirectory=/opt/trading-bot
EnvironmentFile=/etc/trading-platform/runtime.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/opt/trading-bot/.venv-runtime/bin/python -m src.services.process --config /opt/trading-bot/config/platform.json --node linux-optiplex --process market-gateway --validate
ExecStart=/opt/trading-bot/.venv-runtime/bin/python -m src.services.process --config /opt/trading-bot/config/platform.json --node linux-optiplex --process market-gateway
Restart=always
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trading-bot/data /opt/trading-bot/runtime
Slice=trading-platform-critical.slice

[Install]
WantedBy=multi-user.target
