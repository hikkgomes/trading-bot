[Unit]
Description=Trading platform Linux research service %i
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=trading-research
Group=trading-research
WorkingDirectory=/opt/trading-bot
EnvironmentFile=/etc/trading-platform/%i.env
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
ExecStart=/opt/trading-bot/.venv-research/bin/python -m src.services.supervisor --config /opt/trading-bot/config/platform.json --node linux-optiplex --service %i
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trading-bot/data/research /opt/trading-bot/runtime
Slice=trading-platform-background.slice

[Install]
WantedBy=multi-user.target
