{
  "schema": "platform/v2",
  "nodes": [
    {
      "node_id": "linux-optiplex",
      "operating_system": "linux",
      "production_authority": true,
      "services": [
        "market-gateway",
        "data-writer",
        "feature-service",
        "portfolio-engine",
        "portfolio-state-service",
        "risk-engine",
        "execution-engine",
        "paper-engine",
        "product-supervisor",
        "accounting-service",
        "account-reconciliation",
        "promotion-engine",
        "control-api",
        "strategy-evaluator",
        "universe-service",
        "platform-scheduler",
        "research-worker",
        "ml-worker",
        "event-replay-worker",
        "agent-sandbox",
        "agent-coordinator",
        "feature-build-worker",
        "migration-service",
        "evaluation-worker"
      ]
    }
  ],
  "postgresql": {
    "url_env": "TRADING_PLATFORM_DATABASE_URL",
    "connect_timeout_seconds": 5,
    "require_tls": true,
    "local_socket": true
  },
  "paths": {
    "parquet": "data",
    "artefacts": "data/artefacts",
    "backups": "runtime/backups"
  },
  "worker_limits": {
    "research-worker": 2,
    "ml-worker": 1,
    "event-replay-worker": 1,
    "feature-build-worker": 2,
    "strategy-evaluator": 1,
    "universe-service": 1,
    "platform-scheduler": 1,
    "account-reconciliation": 1,
    "heavy-compute-slots": 1,
    "evaluation-worker": 1
  },
  "network": {
    "transport": "local",
    "postgresql_host_env": "TRADING_PLATFORM_DATABASE_HOST",
    "artefact_sync_host_env": "TRADING_PLATFORM_ARTEFACT_HOST"
  },
  "resource_limits": {
    "memory_mb": 8192,
    "heavy_compute_slots": 1,
    "research_job_memory_mb": 2048,
    "numerical_threads": 2,
    "parquet_scan_rows": 1000000,
    "event_replay_window_seconds": 86400,
    "maximum_queue_age_seconds": 86400,
    "ml_trials": 8,
    "sql_pool_size": 2
  },
  "security_domains": {
    "trading-runtime": [
      "market-gateway",
      "data-writer",
      "feature-service",
      "strategy-evaluator",
      "portfolio-engine",
      "portfolio-state-service",
      "risk-engine",
      "execution-engine",
      "paper-engine",
      "product-supervisor",
      "accounting-service",
      "account-reconciliation",
      "control-api",
      "universe-service",
      "platform-scheduler",
      "promotion-engine"
    ],
    "trading-research": [
      "research-worker",
      "ml-worker",
      "event-replay-worker",
      "feature-build-worker",
      "agent-coordinator"
    ],
    "trading-agent": [
      "agent-sandbox"
    ],
    "trading-migration": [
      "migration-service"
    ],
    "trading-evaluator": [
      "evaluation-worker"
    ]
  },
  "processes": {
    "market-gateway": [
      "market-gateway"
    ],
    "data-writer": [
      "data-writer"
    ],
    "trading-runtime": [
      "feature-service",
      "strategy-evaluator",
      "product-supervisor",
      "portfolio-engine",
      "portfolio-state-service",
      "risk-engine",
      "execution-engine",
      "paper-engine",
      "accounting-service",
      "account-reconciliation"
    ],
    "scheduler-operations": [
      "universe-service",
      "platform-scheduler",
      "promotion-engine"
    ],
    "research-runtime": [
      "research-worker",
      "ml-worker",
      "event-replay-worker",
      "feature-build-worker",
      "agent-coordinator"
    ],
    "agent-runtime": [
      "agent-sandbox"
    ],
    "control-api": [
      "control-api"
    ],
    "migration-service": [
      "migration-service"
    ],
    "evaluation-runtime": [
      "evaluation-worker"
    ]
  },
  "logging": {
    "format": "json",
    "level": "INFO"
  },
  "metrics": {
    "bind": "127.0.0.1:9108",
    "heartbeat_seconds": 15,
    "stale_after_seconds": 60
  },
  "alerting": {
    "enabled": true,
    "sink": "webhook",
    "minimum_valid_screenings_before_progress": 10
  },
  "backup": {
    "postgresql_schedule": "hourly",
    "parquet_schedule": "daily",
    "retention_days": 7,
    "hourly_retention_hours": 6,
    "restore_test_schedule": "weekly",
    "maximum_age_seconds": 172800,
    "minimum_free_bytes": 5368709120
  }
}
