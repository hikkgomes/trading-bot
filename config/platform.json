{
  "schema": "platform/v1",
  "nodes": [
    {
      "node_id": "linux-optiplex",
      "operating_system": "linux",
      "production_authority": true,
      "services": [
        "market-gateway",
        "data-writer",
        "feature-service",
        "portfolio-engine",
        "risk-engine",
        "execution-engine",
        "paper-engine",
        "product-supervisor",
        "accounting-service",
        "promotion-engine",
        "control-api"
      ]
    },
    {
      "node_id": "macbook-research",
      "operating_system": "macos",
      "production_authority": false,
      "services": [
        "research-worker",
        "ml-worker",
        "event-replay-worker",
        "agent-sandbox",
        "feature-build-worker",
        "report-worker"
      ]
    }
  ],
  "postgresql": {
    "url_env": "TRADING_PLATFORM_DATABASE_URL",
    "connect_timeout_seconds": 5,
    "require_tls": true
  },
  "paths": {
    "parquet": "data",
    "artefacts": "data/artefacts",
    "reports": "data/reports",
    "backups": "runtime/backups"
  },
  "worker_limits": {
    "research-worker": 2,
    "ml-worker": 1,
    "event-replay-worker": 1,
    "feature-build-worker": 2,
    "report-worker": 1
  },
  "network": {
    "transport": "tailscale",
    "postgresql_host_env": "TRADING_PLATFORM_DATABASE_HOST",
    "artefact_sync_host_env": "TRADING_PLATFORM_ARTEFACT_HOST"
  },
  "logging": {
    "format": "json",
    "level": "INFO"
  },
  "metrics": {
    "bind": "127.0.0.1:9108",
    "heartbeat_seconds": 15,
    "stale_after_seconds": 60
  },
  "alerting": {
    "enabled": true,
    "sink": "existing_autopilot_alerts"
  },
  "backup": {
    "postgresql_schedule": "hourly",
    "parquet_schedule": "daily",
    "retention_days": 30,
    "restore_test_schedule": "weekly"
  }
}
