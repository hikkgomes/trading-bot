{
  "schema": "platform/v2",
  "nodes": [
    {
      "node_id": "linux-optiplex",
      "operating_system": "linux",
      "production_authority": true,
      "services": [
        "market-gateway",
        "data-writer",
        "feature-service",
        "portfolio-engine",
        "risk-engine",
        "execution-engine",
        "paper-engine",
        "product-supervisor",
        "accounting-service",
        "promotion-engine",
        "control-api",
        "strategy-evaluator",
        "universe-service",
        "research-worker",
        "ml-worker",
        "event-replay-worker",
        "agent-sandbox",
        "feature-build-worker",
        "report-worker",
        "migration-service"
      ]
    }
  ],
  "postgresql": {
    "url_env": "TRADING_PLATFORM_DATABASE_URL",
    "connect_timeout_seconds": 5,
    "require_tls": true,
    "local_socket": true
  },
  "paths": {
    "parquet": "data",
    "artefacts": "data/artefacts",
    "reports": "data/reports",
    "backups": "runtime/backups"
  },
  "worker_limits": {
    "research-worker": 2,
    "ml-worker": 1,
    "event-replay-worker": 1,
    "feature-build-worker": 2,
    "report-worker": 1,
    "strategy-evaluator": 1,
    "universe-service": 1,
    "heavy-compute-slots": 1
  },
  "network": {
    "transport": "local",
    "postgresql_host_env": "TRADING_PLATFORM_DATABASE_HOST",
    "artefact_sync_host_env": "TRADING_PLATFORM_ARTEFACT_HOST"
  },
  "resource_limits": {
    "memory_mb": 8192,
    "heavy_compute_slots": 1,
    "research_job_memory_mb": 3072,
    "numerical_threads": 2,
    "parquet_scan_rows": 250000,
    "event_replay_window_seconds": 86400,
    "ml_trials": 8,
    "sql_pool_size": 2
  },
  "security_domains": {
    "trading-runtime": ["market-gateway", "data-writer", "feature-service", "strategy-evaluator", "portfolio-engine", "risk-engine", "execution-engine", "paper-engine", "product-supervisor", "accounting-service", "promotion-engine", "control-api", "universe-service"],
    "trading-research": ["research-worker", "ml-worker", "event-replay-worker", "feature-build-worker", "report-worker"],
    "trading-agent": ["agent-sandbox"],
    "trading-migration": ["migration-service"]
  },
  "logging": {
    "format": "json",
    "level": "INFO"
  },
  "metrics": {
    "bind": "127.0.0.1:9108",
    "heartbeat_seconds": 15,
    "stale_after_seconds": 60
  },
  "alerting": {
    "enabled": true,
    "sink": "existing_autopilot_alerts"
  },
  "backup": {
    "postgresql_schedule": "hourly",
    "parquet_schedule": "daily",
    "retention_days": 30,
    "restore_test_schedule": "weekly"
  }
}
