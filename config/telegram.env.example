# Copy to runtime/telegram.env and chmod 600. Never commit the real token.
AUTOPILOT_TELEGRAM_BOT_TOKEN=
AUTOPILOT_TELEGRAM_CHAT_ID=

# Pause-only commands are off by default. Enabling them also requires an
# explicit comma-separated allowlist of positive Telegram user IDs.
AUTOPILOT_TELEGRAM_PAUSE_COMMANDS=0
AUTOPILOT_TELEGRAM_ALLOWED_USER_IDS=
