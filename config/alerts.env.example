# Copy to runtime/alerts.env and chmod 600. The trading supervisor and
# healthcheck read it through a strict two-key parser; systemd never imports it
# as a process EnvironmentFile. Research, candidate-paper, and backup workers
# cannot read it. Keep exchange credentials out of it.
AUTOPILOT_WEBHOOK_URL=
AUTOPILOT_TELEGRAM_SETTINGS_FILE=runtime/telegram.env
