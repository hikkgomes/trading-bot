{
  "schema": "platform/v2",
  "nodes": [
    {
      "node_id": "linux-optiplex",
      "operating_system": "linux",
      "production_authority": true,
      "services": [
        "market-gateway", "data-writer", "feature-service", "strategy-evaluator",
        "portfolio-engine", "portfolio-state-service", "risk-engine", "execution-engine", "paper-engine",
        "product-supervisor", "accounting-service", "account-reconciliation", "promotion-engine",
        "control-api", "universe-service", "platform-scheduler", "migration-service"
      ]
    },
    {
      "node_id": "linux-research-worker",
      "operating_system": "linux",
      "production_authority": false,
      "services": [
        "research-worker", "ml-worker", "event-replay-worker",
        "feature-build-worker", "agent-sandbox"
      ]
    }
  ],
  "postgresql": {
    "url_env": "TRADING_PLATFORM_DATABASE_URL",
    "connect_timeout_seconds": 5,
    "require_tls": true,
    "local_socket": true
  },
  "paths": {
    "parquet": "data",
    "artefacts": "data/artefacts",
    "backups": "runtime/backups"
  },
  "worker_limits": {"heavy-compute-slots": 1},
  "network": {"transport": "local"},
  "logging": {"format": "json", "level": "INFO"},
  "metrics": {"bind": "127.0.0.1:9108", "heartbeat_seconds": 15, "stale_after_seconds": 60},
  "alerting": {"enabled": true, "sink": "webhook", "minimum_valid_screenings_before_progress": 10},
  "backup": {"postgresql_schedule": "hourly", "parquet_schedule": "daily", "retention_days": 30, "restore_test_schedule": "weekly", "maximum_age_seconds": 172800, "minimum_free_bytes": 536870912},
  "resource_limits": {"memory_mb": 8192, "heavy_compute_slots": 1, "research_job_memory_mb": 3072, "numerical_threads": 2},
  "security_domains": {
    "trading-runtime": ["market-gateway", "data-writer", "feature-service", "strategy-evaluator", "portfolio-engine", "portfolio-state-service", "risk-engine", "execution-engine", "paper-engine", "product-supervisor", "accounting-service", "account-reconciliation", "control-api", "universe-service", "platform-scheduler"],
    "trading-research": ["promotion-engine", "research-worker", "ml-worker", "event-replay-worker", "feature-build-worker"],
    "trading-agent": ["agent-sandbox"],
    "trading-migration": ["migration-service"]
  },
  "processes": {
    "trading-runtime": ["market-gateway", "data-writer", "feature-service", "strategy-evaluator", "portfolio-engine", "portfolio-state-service", "risk-engine", "execution-engine", "paper-engine", "product-supervisor", "accounting-service", "account-reconciliation", "universe-service", "platform-scheduler"],
    "research-runtime": ["promotion-engine", "research-worker", "ml-worker", "event-replay-worker", "feature-build-worker"],
    "agent-runtime": ["agent-sandbox"],
    "control-api": ["control-api"],
    "migration-service": ["migration-service"]
  }
}
