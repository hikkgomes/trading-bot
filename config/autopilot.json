{
  "approval_ledger": "runtime/approvals.json",
  "artifact_hygiene_file": "runtime/artifact_hygiene.json",
  "backup_report_file": "runtime/backup_report.json",
  "backup_enabled": true,
  "backup_cadence_seconds": 86400,
  "backup_timeout_seconds": 60,
  "auto_report_enabled": true,
  "alert_cooldown_seconds": 900,
  "alert_file": "runtime/alerts.jsonl",
  "alert_state_file": "runtime/alert_state.json",
  "alerts_enabled": true,
  "advisory_alerts_enabled": false,
  "position_change_alerts_enabled": true,
  "daily_digest_enabled": false,
  "daily_digest_cadence_seconds": 86400,
  "control_file": "runtime/operator-control/control.json",
  "control_audit_file": "runtime/operator-control/control_audit.jsonl",
  "candidate_paper_enabled": true,
  "candidate_paper_status_file": "runtime/candidate_paper_status.json",
  "candidate_paper_cadence_seconds": 45,
  "candidate_paper_max_unseen_bars": 240,
  "candidate_paper_timeout_seconds": 240,
  "event_capture_enabled": true,
  "event_capture_status_file": "runtime/event_capture_status.json",
  "event_capture_max_age_seconds": 120,
  "portfolio_risk_file": "runtime/portfolio_risk.json",
  "portfolio_risk_required": true,
  "portfolio_risk_max_age_seconds": 86400,
  "trade_starvation_enabled": true,
  "trade_starvation_history_file": "runtime/trade_starvation_history.jsonl",
  "trade_starvation_report_file": "runtime/trade_starvation.json",
  "trade_starvation_window_days": 30,
  "active_income_max_open_positions": 3,
  "active_income_max_gross_fraction": 0.6,
  "active_income_max_net_fraction": 0.4,
  "active_income_max_symbol_fraction": 0.25,
  "active_income_max_correlated_fraction": 0.4,
  "active_income_max_abs_beta_fraction": 0.4,
  "active_income_max_portfolio_drawdown_fraction": 0.1,
  "active_income_min_alpha_confidence": 0.5,
  "active_income_min_alpha_score": 0.55,
  "job_state_file": "runtime/job_state.json",
  "lock_file": "runtime/autopilot.lock",
  "incubation_candidates_file": "runtime/incubation_candidates.json",
  "min_runtime_free_bytes": 536870912,
  "max_jobs_per_cycle": 1,
  "max_consecutive_job_deferrals": 16,
  "research_cycle_file": "runtime/research_cycle.json",
  "research_factory_config_file": "config/research_factory.json",
  "generated_batch_file": "runtime/research/generated_hypotheses.json",
  "experiment_memory_file": "runtime/research/experiment_memory.sqlite3",
  "experiment_memory_backup_file": "runtime/research/experiment_memory.backup.sqlite3",
  "loop_sleep_seconds": 60,
  "operator_report_file": "runtime/operator_report.md",
  "operator_report_json_file": "runtime/operator_report.json",
  "readiness_report_file": "runtime/readiness_report.md",
  "readiness_report_json_file": "runtime/readiness_report.json",
  "research_smoke_file": "runtime/research_smoke.json",
  "strategy_smoke_file": "runtime/strategy_framework_smoke.json",
  "run_data_update": false,
  "status_file": "runtime/status.json",
  "webhook_url_env": "AUTOPILOT_WEBHOOK_URL",
  "jobs": [
    {
      "name": "market_universe_screen",
      "enabled": true,
      "command": [
        ".venv/bin/python", "-m", "src.autopilot.market_universe",
        "--config", "config/market_universe.json",
        "--output", "runtime/market_universe.json",
        "--snapshot-dir", "runtime/market_universe_snapshots"
      ],
      "cadence_seconds": 86400,
      "timeout_seconds": 180
    },
    {
      "name": "market_data_update_universe",
      "enabled": true,
      "command": [
        ".venv/bin/python", "-m", "src.autopilot.universe_history",
        "--config", "config/research_factory.json",
        "--market-universe-report", "runtime/market_universe.json",
        "--exclude-timeframes", "1m",
        "--max-runtime-seconds", "240",
        "--output", "runtime/universe_history.json"
      ],
      "cadence_seconds": 21600,
      "timeout_seconds": 1800
    },
    {
      "name": "market_data_update_universe_1m",
      "enabled": true,
      "command": [
        ".venv/bin/python", "-m", "src.autopilot.universe_history",
        "--config", "config/research_factory.json",
        "--market-universe-report", "runtime/market_universe.json",
        "--timeframes", "1m",
        "--max-runtime-seconds", "240",
        "--output", "runtime/universe_history_1m.json"
      ],
      "cadence_seconds": 21600,
      "timeout_seconds": 1800
    },
    {
      "name": "market_data_update_futures",
      "enabled": true,
      "command": [
        ".venv/bin/python", "-m", "src.autopilot.history_bootstrap",
        "--config", "config/research_factory.json",
        "--market", "futures",
        "--exclude-timeframes", "1m",
        "--report", "runtime/history_bootstrap_futures.json"
      ],
      "cadence_seconds": 21600,
      "timeout_seconds": 1800
    },
    {
      "name": "regime_tag_futures_15m",
      "enabled": true,
      "command": [
        ".venv/bin/python", "-m", "src.regime",
        "--market", "futures",
        "--timeframe", "15m",
        "--daily-timeframe", "1d",
        "--output", "runtime/regime/futures_15m_regime.parquet",
        "--report", "runtime/regime_tag_futures_15m.json",
        "--compact",
        "--skip-if-missing"
      ],
      "cadence_seconds": 21600,
      "timeout_seconds": 300
    },
    {
      "name": "portfolio_risk",
      "enabled": true,
      "command": [
        ".venv/bin/python", "-m", "src.autopilot.portfolio_risk",
        "--config", "config/portfolio_risk.json",
        "--output", "runtime/portfolio_risk.json"
      ],
      "cadence_seconds": 21600,
      "timeout_seconds": 120
    },
    {
      "name": "relative_value_research",
      "enabled": true,
      "command": [
        ".venv/bin/python", "-m", "src.autopilot.relative_value_research",
        "--config", "config/relative_value.json",
        "--output", "runtime/research/relative_value.json"
      ],
      "cadence_seconds": 21600,
      "timeout_seconds": 120
    },
    {
      "name": "relative_value_paper",
      "enabled": true,
      "command": [
        ".venv/bin/python", "-m", "src.autopilot.relative_value_paper",
        "--input", "runtime/research/relative_value.json",
        "--output", "runtime/research/relative_value_paper.json",
        "--state", "runtime/research/relative_value_paper_state.json",
        "--timeframe", "1h"
      ],
      "cadence_seconds": 3600,
      "timeout_seconds": 120
    },
    {
      "name": "microstructure_research",
      "enabled": true,
      "command": [
        ".venv/bin/python", "-m", "src.autopilot.microstructure_research",
        "--config", "config/microstructure_research.json",
        "--output", "runtime/research/microstructure.json"
      ],
      "cadence_seconds": 900,
      "timeout_seconds": 300
    },
    {
      "name": "market_data_update_futures_1m",
      "enabled": true,
      "command": [
        ".venv/bin/python", "-m", "src.autopilot.history_bootstrap",
        "--config", "config/research_factory.json",
        "--market", "futures",
        "--timeframes", "1m",
        "--report", "runtime/history_bootstrap_futures_1m.json"
      ],
      "cadence_seconds": 21600,
      "timeout_seconds": 1800
    },
    {
      "name": "market_data_update_spot",
      "enabled": true,
      "command": [
        ".venv/bin/python", "-m", "src.autopilot.history_bootstrap",
        "--config", "config/research_factory.json",
        "--market", "spot",
        "--report", "runtime/history_bootstrap_spot.json"
      ],
      "cadence_seconds": 21600,
      "timeout_seconds": 1800
    },
    {
      "name": "strategy_catalog_smoke",
      "enabled": false,
      "command": [".venv/bin/python", "-m", "src.run_backtest", "--list"],
      "cadence_seconds": 86400,
      "timeout_seconds": 180
    },
    {
      "name": "research_synthetic_smoke",
      "enabled": true,
      "command": [
        ".venv/bin/python", "-m", "src.autopilot.research_smoke",
        "--output", "runtime/research_smoke.json"
      ],
      "cadence_seconds": 86400,
      "timeout_seconds": 300
    },
    {
      "name": "research_factory",
      "enabled": true,
      "command": [
        ".venv/bin/python", "-m", "src.autopilot.research_factory",
        "--config", "config/research_factory.json",
        "--market-universe-report", "runtime/market_universe.json",
        "--output", "runtime/research/generated_hypotheses.json"
      ],
      "cadence_seconds": 21600,
      "timeout_seconds": 120
    },
    {
      "name": "mutation_plan",
      "enabled": true,
      "command": [
        ".venv/bin/python", "-m", "src.autopilot.mutation_plan",
        "--input", "runtime/research_cycle.json",
        "--exploration-status", "runtime/exploration_paper/status.json",
        "--experiment-log", "outputs/research_exploration/experiment_log.jsonl",
        "--output", "runtime/mutation_plan.json",
        "--markdown-output", "runtime/mutation_plan.md",
        "--max-total", "12"
      ],
      "cadence_seconds": 21600,
      "timeout_seconds": 120
    },
    {
      "name": "mutation_batch",
      "enabled": true,
      "command": [
        ".venv/bin/python", "-m", "src.autopilot.mutation_batch",
        "--input", "runtime/mutation_plan.json",
        "--output", "runtime/mutation_hypotheses.json",
        "--max-total", "12"
      ],
      "cadence_seconds": 21600,
      "timeout_seconds": 120
    },
    {
      "name": "research_cycle",
      "enabled": true,
      "command": [
        ".venv/bin/python", "-m", "src.autopilot.research_cycle",
        "--output", "runtime/research_cycle.json",
        "--state", "runtime/research_cycle_state.json",
        "--include-generated",
        "--include-mutations",
        "--generated-batch", "runtime/research/generated_hypotheses.json",
        "--mutation-batch", "runtime/mutation_hypotheses.json",
        "--research-factory-config", "config/research_factory.json"
      ],
      "cadence_seconds": 21600,
      "timeout_seconds": 1800
    },
    {
      "name": "ml_research",
      "enabled": true,
      "command": [
        ".venv/bin/python", "-m", "src.autopilot.ml_research",
        "--config", "config/ml_research.json",
        "--output", "runtime/research/ml_research.json",
        "--state", "runtime/research/ml_research_state.json"
